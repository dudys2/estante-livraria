{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Bash(cat **/.env*)",
      "Bash(cat .env*)",
      "Bash(type **/.env*)",
      "Bash(grep **/.env*)",
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(mysql:*)"
    ]
  }
}
